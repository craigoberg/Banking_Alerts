# Leave these blank to run the local demo.
# Sign in with username demo and password local-demo.
# Do not commit real values. Copy this file to .env.local and fill it on your machine
# or set the same names in Vercel.

# RedBark. Craig's key prefix is rdk_live_. The v2 docs example uses rbk_live_.
REDBARK_API_KEY=
REDBARK_VERSION=2026-10-01.wattle

# Supabase service role for the new Sydney database (ap-southeast-2).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postmark server token. Without it, alert emails are logged and the app keeps working.
POSTMARK_SERVER_TOKEN=

# Signs the login cookie. Required in production.
SESSION_SECRET=

# Vercel sends Authorization: Bearer <CRON_SECRET> to /api/cron/daily.
CRON_SECRET=

# Used only by `npm run seed-login` when Supabase is configured.
# Not the local demo password, and not committed.
DEMO_USERNAME=
DEMO_PASSWORD=
